rules_version = '2';

// Production-Grade Firestore Security Rules for Wular Sports E-Commerce
// Last Updated: 2026-01-14
// Security Level: Enterprise
// Compliance: GDPR, DPDP-India

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // HELPER FUNCTIONS
    // ========================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is admin (custom claim)
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    // Check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Validate email format
    function isValidEmail(email) {
      return email is string 
        && email.size() > 3 
        && email.size() < 255
        && email.matches('.*@.*\\..*');
    }
    
    // Validate phone number (Indian format)
    function isValidPhone(phone) {
      return phone is string 
        && phone.size() >= 10 
        && phone.size() <= 15
        && phone.matches('^[+0-9]*$');
    }
    
    // Validate string length
    function isValidString(str, minLen, maxLen) {
      return str is string 
        && str.size() >= minLen 
        && str.size() <= maxLen;
    }
    
    // Validate positive number
    function isPositiveNumber(num) {
      return num is number && num > 0;
    }
    
    // Rate limiting: prevent creation spam (max 5 per hour per IP)
    function rateLimitCreate() {
      // This is a basic check; for production use Firebase App Check
      return request.time > resource.data.createdAt + duration.value(12, 'm');
    }
    
    // ========================================
    // DEFAULT DENY ALL
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }
    
    // ========================================
    // SUBSCRIBERS COLLECTION
    // ========================================
    // Security Model: Write-only for public, Read-only for admin
    
    match /subscribers/{subscriberId} {
      
      // PUBLIC: Can only CREATE (write-once)
      allow create: if 
        // Must be a valid email
        isValidEmail(request.resource.data.email)
        // Must have required fields only
        && request.resource.data.keys().hasAll(['email', 'subscribedAt', 'status'])
        && request.resource.data.keys().hasOnly(['email', 'subscribedAt', 'status'])
        // Status must be 'active'
        && request.resource.data.status == 'active'
        // SubscribedAt must be a timestamp close to now (prevent backdating)
        && request.resource.data.subscribedAt is timestamp
        && request.resource.data.subscribedAt > request.time - duration.value(1, 'm')
        && request.resource.data.subscribedAt < request.time + duration.value(1, 'm')
        // Email must be lowercase (enforced)
        && request.resource.data.email == request.resource.data.email.lower();
      
      // PUBLIC: CANNOT read, update, or delete
      allow read: if false;
      allow update: if false;
      allow delete: if false;
      
      // ADMIN: Full read access to all subscribers
      allow read: if isAdmin();
      
      // ADMIN: Can update status (e.g., unsubscribe)
      allow update: if isAdmin() 
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['active', 'unsubscribed'];
      
      // ADMIN: Can delete subscribers
      allow delete: if isAdmin();
    }
    
    // ========================================
    // ORDERS COLLECTION  
    // ========================================
    // Security Model: Authenticated write-only, owner read, admin full access
    
    match /orders/{orderId} {
      
      // AUTHENTICATED USERS: Can CREATE orders only
      allow create: if 
        isAuthenticated()
        // Must include userId and it must match authenticated user
        && request.resource.data.userId == request.auth.uid
        // Required fields validation
        && request.resource.data.keys().hasAll([
          'userId',
          'orderNumber', 
          'customerName', 
          'customerEmail',
          'customerPhone',
          'customerAddress',
          'items',
          'total',
          'status',
          'paymentStatus',
          'paymentMethod',
          'createdAt',
          'updatedAt'
        ])
        // Field type and format validation
        && isValidString(request.resource.data.customerName, 2, 100)
        && isValidEmail(request.resource.data.customerEmail)
        && isValidPhone(request.resource.data.customerPhone)
        && request.resource.data.customerAddress is map
        && isValidString(request.resource.data.customerAddress.street, 10, 500)
        && isValidString(request.resource.data.customerAddress.city, 2, 100)
        && isValidString(request.resource.data.customerAddress.state, 2, 100)
        && request.resource.data.customerAddress.pincode.matches('^[0-9]{6}$')
        // Items validation
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50  // Max 50 items per order
        // Total must be positive
        && isPositiveNumber(request.resource.data.total)
        && request.resource.data.total >= 100  // Minimum order value ₹100
        && request.resource.data.total <= 1000000  // Maximum ₹10 lakh
        // Status must be 'pending' on creation
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentStatus == 'pending'
        // Payment method validation
        && request.resource.data.paymentMethod in ['full', 'cod']
        // Timestamps must be close to now
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt > request.time - duration.value(1, 'm')
        && request.resource.data.createdAt < request.time + duration.value(1, 'm')
        && request.resource.data.updatedAt == request.resource.data.createdAt
        // Order number must follow pattern
        && request.resource.data.orderNumber.matches('^WS[0-9]+$');
      
      // USERS: Can read ONLY their own orders
      allow read: if isOwner(resource.data.userId);
      
      // USERS: CANNOT update or delete their own orders
      allow update: if false;
      allow delete: if false;
      
      // ADMIN: Full access to all orders
      allow read: if isAdmin();
      
      // ADMIN: Can update order status and payment status
      allow update: if isAdmin()
        && request.resource.data.userId == resource.data.userId  // Cannot change user
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 
          'paymentStatus', 
          'paymentId',
          'updatedAt'
        ])
        && request.resource.data.status in [
          'pending', 
          'confirmed', 
          'processing', 
          'shipped', 
          'delivered', 
          'cancelled'
        ]
        && request.resource.data.paymentStatus in ['pending', 'completed', 'failed']
        && request.resource.data.updatedAt is timestamp;
      
      // ADMIN: Can delete orders
      allow delete: if isAdmin();
    }
    
    // ========================================
    // QUERIES & LIST OPERATIONS
    // ========================================
    
    // Prevent mass enumeration attacks
    // Admin can query, users can only query their own data
    match /orders/{orderId} {
      allow list: if 
        isAdmin() 
        || (isAuthenticated() && request.query.limit <= 100);
    }
    
    match /subscribers/{subscriberId} {
      allow list: if isAdmin() && request.query.limit <= 1000;
    }
    
    // ========================================
    // SECURITY NOTES
    // ========================================
    // 1. All writes require authentication (prevents anonymous spam)
    // 2. Users can only read their own orders (privacy)
    // 3. Subscribers collection is write-only for public (email privacy)
    // 4. Admin access requires custom claim (set via Admin SDK)
    // 5. Field validation prevents malformed data
    // 6. Timestamp validation prevents backdating/future-dating
    // 7. Amount limits prevent fraudulent orders
    // 8. List query limits prevent mass scraping
    // 9. GDPR compliant: Users can request deletion via admin
    // 10. No direct deletes by users (audit trail required)
  }
}
