rules_version = '2';

// Production-Grade Firestore Security Rules for Wular Sports E-Commerce
// Last Updated: 2026-01-14
// Security Level: Enterprise
// Compliance: GDPR, DPDP-India

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // HELPER FUNCTIONS
    // ========================================
    
    // Check if user is authenticated
    // An optional text field: absent, or text no longer than `max`.
    // (`.size()` alone also accepts lists and maps — someone could store a
    // ~1 MB list in a review, or a map as a lead's email, which crashed the admin panel.)
    function optText(field, max) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }

    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is admin: the store owner's verified Google email,
    // or a Firebase custom claim (admin: true)
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == 'moinwani91@gmail.com'
          && request.auth.token.email_verified == true)
        || request.auth.token.admin == true
      );
    }
    
    // Check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Validate email format
    function isValidEmail(email) {
      return email is string 
        && email.size() > 3 
        && email.size() < 255
        && email.matches('.*@.*\\..*');
    }
    
    // Validate phone number: '+' country code (may contain '-') + 6-15 digits
    function isValidPhone(phone) {
      return phone is string
        && phone.size() >= 8
        && phone.size() <= 23
        && phone.matches('^[+][0-9-]*$');
    }
    
    // Validate string length
    function isValidString(str, minLen, maxLen) {
      return str is string 
        && str.size() >= minLen 
        && str.size() <= maxLen;
    }
    
    // Validate positive number
    function isPositiveNumber(num) {
      return num is number && num > 0;
    }
    
    // ========================================
    // DEFAULT DENY ALL
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }
    
    // ========================================
    // SUBSCRIBERS COLLECTION
    // ========================================
    // Security Model: Write-only for public, Read-only for admin
    
    match /subscribers/{subscriberId} {
      
      // PUBLIC: Can only CREATE (write-once); requires a Firebase session
      // (anonymous is fine) so writes can't come from bare REST spam
      allow create: if
        isAuthenticated()
        // Must be a valid email
        && isValidEmail(request.resource.data.email)
        // Must have required fields only
        && request.resource.data.keys().hasAll(['email', 'subscribedAt', 'status'])
        && request.resource.data.keys().hasOnly(['email', 'subscribedAt', 'status'])
        // Status must be 'active'
        && request.resource.data.status == 'active'
        // SubscribedAt must be a timestamp close to now (prevent backdating)
        && request.resource.data.subscribedAt is timestamp
        && request.resource.data.subscribedAt > request.time - duration.value(1, 'm')
        && request.resource.data.subscribedAt < request.time + duration.value(1, 'm')
        // Email must be lowercase (enforced)
        && request.resource.data.email == request.resource.data.email.lower();
      
      // PUBLIC: CANNOT read, update, or delete
      allow read: if false;
      allow update: if false;
      allow delete: if false;
      
      // ADMIN: Full read access to all subscribers
      allow read: if isAdmin();
      
      // ADMIN: Can update status (e.g., unsubscribe)
      allow update: if isAdmin() 
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['active', 'unsubscribed'];
      
      // ADMIN: Can delete subscribers
      allow delete: if isAdmin();
    }
    
    // ========================================
    // LEADS COLLECTION (checkout lead capture)
    // ========================================
    // Visitors save their own partial checkout details (doc id == their uid);
    // only the admin can read them.

    match /leads/{leadId} {

      allow create, update: if
        isAuthenticated()
        && request.auth.uid == leadId
        && request.resource.data.keys().hasOnly([
          'firstName', 'lastName', 'email', 'phone', 'countryCode',
          'address', 'city', 'state', 'zip', 'country',
          'cartSummary', 'cartTotal', 'status', 'updatedAt',
          'whatsappClicks', 'lastWhatsAppSource', 'whatsappProduct', 'visitorRef'
        ])
        && request.resource.data.get('status', 'browsing') in ['browsing', 'converted']
        && request.resource.data.get('cartTotal', 0) is number
        && request.resource.data.get('whatsappClicks', 0) is number
        && optText('firstName', 100)
        && optText('lastName', 100)
        && optText('email', 254)
        && optText('phone', 20)
        && optText('countryCode', 10)
        && optText('address', 500)
        && optText('city', 100)
        && optText('state', 100)
        && optText('zip', 15)
        && optText('country', 100)
        && optText('cartSummary', 600)
        && optText('lastWhatsAppSource', 100)
        && optText('whatsappProduct', 200)
        && optText('visitorRef', 20);

      // ADMIN: full access — read leads, mark them sold, clean up
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
      allow list: if isAdmin() && request.query.limit <= 1000;
    }

    // ========================================
    // REVIEWS COLLECTION (customer product reviews)
    // ========================================
    // Anyone signed in (anonymous ok) can submit a review, which starts as
    // 'pending'. Only approved reviews are publicly readable; the admin
    // moderates (approve / delete).

    match /reviews/{reviewId} {

      allow create: if
        isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'productId', 'rating', 'text', 'name', 'city',
          'status', 'userId', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'productId', 'rating', 'status', 'userId', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.productId is string
        && request.resource.data.productId.size() <= 60
        && optText('text', 1000)
        && optText('name', 60)
        && optText('city', 60)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt > request.time - duration.value(1, 'm')
        && request.resource.data.createdAt < request.time + duration.value(1, 'm');

      // Public can read approved reviews only; admin sees everything
      allow get: if resource.data.status == 'approved' || isAdmin();
      allow list: if
        (request.query.limit <= 50 && resource.data.status == 'approved')
        || (isAdmin() && request.query.limit <= 500);

      // ADMIN: moderate
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ========================================
    // ORDERS COLLECTION
    // ========================================
    // Security Model: Authenticated write-only, owner read, admin full access
    
    match /orders/{orderId} {
      
      // Orders are created only by the server (checkout API, Admin SDK).
      // Browsers can't create them — otherwise anyone could write a fake
      // "paid" order straight into the database.
      allow create: if false;
      
      // USERS: Can read ONLY their own orders
      allow read: if isOwner(resource.data.userId);
      
      // USERS: CANNOT update or delete their own orders
      allow update: if false;
      allow delete: if false;
      
      // ADMIN: Full access to all orders
      allow read: if isAdmin();
      
      // ADMIN: Can update order status and payment status
      allow update: if isAdmin()
        && request.resource.data.userId == resource.data.userId  // Cannot change user
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 
          'paymentStatus', 
          'paymentId',
          'updatedAt',
          'deliveredAt'
        ])
        && request.resource.data.status in [
          'pending', 
          'confirmed', 
          'processing', 
          'shipped', 
          'delivered', 
          'cancelled'
        ]
        && request.resource.data.paymentStatus in ['pending', 'completed', 'failed']
        && request.resource.data.updatedAt is timestamp;
      
      // ADMIN: Can delete orders
      allow delete: if isAdmin();
    }
    
    // ========================================
    // QUERIES & LIST OPERATIONS
    // ========================================
    
    // Prevent mass enumeration attacks
    // Admin can query, users can only query their own data
    match /orders/{orderId} {
      allow list: if 
        isAdmin() 
        || (isOwner(resource.data.userId) && request.query.limit <= 100);
    }
    
    match /subscribers/{subscriberId} {
      allow list: if isAdmin() && request.query.limit <= 1000;
    }
    
    // ========================================
    // SECURITY NOTES
    // ========================================
    // 1. All writes require authentication (prevents anonymous spam)
    // 2. Users can only read their own orders (privacy)
    // 3. Subscribers collection is write-only for public (email privacy)
    // 4. Admin access requires custom claim (set via Admin SDK)
    // 5. Field validation prevents malformed data
    // 6. Timestamp validation prevents backdating/future-dating
    // 7. Amount limits prevent fraudulent orders
    // 8. List query limits prevent mass scraping
    // 9. GDPR compliant: Users can request deletion via admin
    // 10. No direct deletes by users (audit trail required)
  }
}
